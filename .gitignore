.cache/
*.tar.gz
*.tgz
*.zip

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.DS_Store
vendor/moge/

# Credentials — never commit. Modal tokens live in the environment or ~/.modal.toml
.env
.env.local
.modal.toml
modal.toml

